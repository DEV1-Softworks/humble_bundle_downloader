# Recommended: paste the `_simpleauth_sess` cookie from a logged-in
# browser session. This avoids storing your account password at rest.
HUMBLE_SESSION_COOKIE=

# Where the authenticated session is cached (created with 0600
# permissions). After the first successful login no secret is needed.
HUMBLE_SESSION_FILE=.humble_session.json

# Fallback only: used for an interactive password login if no valid
# session is available. The password is NOT read from this file; it is
# prompted for. Leave HUMBLE_PASSWORD unset.
HUMBLE_EMAIL=your-email@example.com
# Optional: prefill a 2FA code for non-interactive use. Normally left blank.
HUMBLE_2FA_CODE=

HUMBLE_DOWNLOAD_DIR=downloads

# Politeness delay (seconds) between HTTP requests. Lower values are
# faster but more likely to get your IP rate-limited or banned.
HUMBLE_REQUEST_DELAY=1.0
